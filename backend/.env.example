FRONTEND_URL=http://localhost:5173
PORT=7889

MONGO_URI=mongodb://localhost:27017/swifty
JWT_SECRET=your_jwt_secret_here
DEFAULT_CURRENCY=MYR

# Razorpay
RAZORPAY_KEY_ID=rzp_test_xxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxx

# AWS S3 (Add these for secure KYC storage)
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_REGION=ap-southeast-1

# Encryption (For sensitive KYC data)
ENCRYPTION_KEY=your_32_char_hex_key_here

# HTTPS (For secure communication)
SSL_KEY_PATH=./key.pem
SSL_CERT_PATH=./cert.pem
NODE_ENV=development  # Or production on deployment