FRONTEND_URL=http://localhost:5173
PORT=7889

MONGO_URI=mongodb://localhost:27017/swifty
JWT_SECRET=your_jwt_secret_here
DEFAULT_CURRENCY=MYR

# Razorpay
RAZORPAY_KEY_ID=rzp_test_xxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxx

# Xendit
XENDIT_SECRET_KEY=xnd_development_your_key_here
XENDIT_WEBHOOK_TOKEN=your_webhook_verification_token
XENDIT_PUBLIC_KEY=xnd_public_development_your_key_here

# AWS S3 (Add these for secure KYC storage)
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_REGION=ap-southeast-1

# Encryption (For sensitive KYC data)
ENCRYPTION_KEY=your_32_char_hex_key_here

# Google Maps / Places API
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Google OAuth (Sign In with Google)
GOOGLE_CLIENT_ID=your_google_client_id_here

# Email / SMTP (AWS SES, SendGrid, or Gmail App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
EMAIL_FROM=no-reply@swifty.my
EMAIL_FROM_NAME=Swifty Car Rentals

# HTTPS (For secure communication)
SSL_KEY_PATH=./key.pem
SSL_CERT_PATH=./cert.pem
NODE_ENV=development  # Or production on deployment